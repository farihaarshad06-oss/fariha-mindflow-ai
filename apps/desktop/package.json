{
  "name": "@mindflow/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Fariha MindFlow AI — Desktop Application (Electron)",
  "author": {
    "name": "Fariha MindFlow AI",
    "email": "support@mindflow.ai"
  },
  "homepage": "https://github.com/farihaarshad06-oss/fariha-mindflow-ai",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @mindflow/web dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "node build-electron.mjs",
    "build": "pnpm --filter @mindflow/web build && node build-electron.mjs && electron-builder",
    "build:win": "pnpm build -- --win",
    "build:mac": "pnpm build -- --mac",
    "build:linux": "pnpm build -- --linux",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "clean": "rimraf dist-electron dist-app"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "prisma": "^5.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.0.1",
    "electron": "^39.8.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "appId": "ai.mindflow.fariha",
    "productName": "Fariha MindFlow AI",
    "copyright": "Copyright © 2024 Fariha MindFlow AI",
    "directories": {
      "output": "dist-app",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron/**/*",
      "prisma/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/prisma/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/nodejs-whisper/**/*"
    ],
    "asarUnpack": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/runtime/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "schema.prisma",
          "migrations/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Education",
      "maintainer": "Fariha MindFlow AI <support@mindflow.ai>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fariha MindFlow AI"
    },
    "publish": null
  }
}
