    "@mindflow/validation": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.0",
    "framer-motion": "^11.5.6",
    "i18next": "^23.15.1",
    "lucide-react": "^0.445.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
